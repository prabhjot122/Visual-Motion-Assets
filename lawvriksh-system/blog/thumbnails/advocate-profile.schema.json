{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/blog/thumbnails/advocate-profile.schema.json",
  "title": "Past-advocate profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper or solid warm ink."
    },
    "kicker": {
      "type": "string",
      "maxLength": 40,
      "description": "Uppercase tracked kicker (clay; edge on dark)."
    },
    "title_html": {
      "type": "string",
      "maxLength": 90,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Headline. Emphasis with <b>…</b> (clay), at most two phrases. Only <b> and <br> are allowed; never <i>."
    },
    "name": {
      "type": "string",
      "maxLength": 36
    },
    "era": {
      "type": "string",
      "maxLength": 40
    },
    "image": {
      "type": "string",
      "description": "Relative path to a licensed image. Leave empty to show the labelled frame."
    },
    "image_alt": {
      "type": "string",
      "maxLength": 120
    },
    "image_label": {
      "type": "string",
      "maxLength": 40
    },
    "meta": {
      "type": "string",
      "maxLength": 36,
      "description": "Right side of the footer, e.g. “[n] min read”."
    }
  },
  "required": [
    "kicker",
    "title_html",
    "name",
    "era"
  ]
}
