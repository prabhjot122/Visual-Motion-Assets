{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/blog/graphics/comparison-07-table-banded.schema.json",
  "title": "Comparison 7 — table-banded",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper or solid warm ink."
    },
    "kicker": {
      "type": "string",
      "maxLength": 40,
      "description": "Uppercase tracked kicker (clay; edge on dark)."
    },
    "title_html": {
      "type": "string",
      "maxLength": 90,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Headline. Emphasis with <b>…</b> (clay), at most two phrases. Only <b> and <br> are allowed; never <i>."
    },
    "left_label": {
      "type": "string",
      "maxLength": 22
    },
    "right_label": {
      "type": "string",
      "maxLength": 22
    },
    "rows": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "left": {
            "type": "string",
            "maxLength": 50
          },
          "right": {
            "type": "string",
            "maxLength": 50
          }
        },
        "required": [
          "left",
          "right"
        ]
      }
    }
  },
  "required": []
}
