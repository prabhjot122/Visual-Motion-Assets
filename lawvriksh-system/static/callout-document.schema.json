{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/static/callout-document.schema.json",
  "title": "Callout with document",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper grain or solid warm ink"
    },
    "kicker": {
      "type": "string",
      "maxLength": 36,
      "description": "Uppercase tracked kicker, clay (edge on dark). Keep under ~28 characters."
    },
    "title_html": {
      "type": "string",
      "maxLength": 110,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Statement. Emphasis with <b>…</b> (clay), at most two phrases. Only <b> and <br> are allowed; never <i>."
    },
    "cite": {
      "type": "string",
      "maxLength": 6
    },
    "callout": {
      "type": "string",
      "maxLength": 90
    },
    "series": {
      "type": "string",
      "maxLength": 24,
      "description": "Right side of the footer, e.g. the series name."
    }
  },
  "required": [
    "kicker",
    "title_html",
    "cite",
    "callout"
  ]
}
