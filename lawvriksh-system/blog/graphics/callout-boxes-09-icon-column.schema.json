{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/blog/graphics/callout-boxes-09-icon-column.schema.json",
  "title": "Callout box 9 — icon-column",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper or solid warm ink."
    },
    "label": {
      "type": "string",
      "maxLength": 30
    },
    "body_html": {
      "type": "string",
      "maxLength": 150,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 56
      }
    }
  },
  "required": []
}
