{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/carousel/closing-cta.schema.json",
  "title": "Closing / CTA",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper grain or solid warm ink"
    },
    "motif": {
      "enum": [
        "reports",
        "files",
        "checked",
        "open-book",
        "courthouse",
        "calendar",
        "notes",
        "compare",
        "judgment",
        "register"
      ],
      "description": "Law object drawn from the library materials; pick the one that matches the idea of the page."
    },
    "kicker": {
      "type": "string",
      "maxLength": 36,
      "description": "Uppercase tracked kicker, clay (edge on dark). Keep under ~28 characters."
    },
    "title_html": {
      "type": "string",
      "maxLength": 110,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Statement. Emphasis with <b>…</b> (clay), at most two phrases. Only <b> and <br> are allowed; never <i>."
    },
    "body_html": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Muted supporting line. Optional <b> emphasis."
    },
    "button": {
      "type": "string",
      "maxLength": 28
    },
    "note": {
      "type": "string",
      "maxLength": 90
    },
    "counter": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "index",
        "total"
      ],
      "description": "Page counter; also positions the thread node."
    }
  },
  "required": [
    "motif",
    "kicker",
    "title_html",
    "button"
  ]
}
