{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/static/myth-check.schema.json",
  "title": "Myth versus check",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper grain or solid warm ink"
    },
    "motif": {
      "enum": [
        "reports",
        "files",
        "checked",
        "open-book",
        "courthouse",
        "calendar",
        "notes",
        "compare",
        "judgment",
        "register"
      ],
      "description": "Law object drawn from the library materials; pick the one that matches the idea of the page."
    },
    "kicker": {
      "type": "string",
      "maxLength": 36,
      "description": "Uppercase tracked kicker, clay (edge on dark). Keep under ~28 characters."
    },
    "myth_label": {
      "type": "string",
      "maxLength": 22
    },
    "myth": {
      "type": "string",
      "maxLength": 80
    },
    "check_label": {
      "type": "string",
      "maxLength": 22
    },
    "check_html": {
      "type": "string",
      "maxLength": 110,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Statement. Emphasis with <b>…</b> (clay), at most two phrases. Only <b> and <br> are allowed; never <i>."
    },
    "series": {
      "type": "string",
      "maxLength": 24,
      "description": "Right side of the footer, e.g. the series name."
    }
  },
  "required": [
    "motif",
    "kicker",
    "myth_label",
    "myth",
    "check_label",
    "check_html"
  ]
}
