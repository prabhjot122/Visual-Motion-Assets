{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/carousel/advocate-profile.schema.json",
  "title": "Advocate series — profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper grain or solid warm ink"
    },
    "image": {
      "type": "string",
      "description": "Relative path to a licensed image. Leave empty to show the labelled frame."
    },
    "image_alt": {
      "type": "string",
      "maxLength": 120
    },
    "image_label": {
      "type": "string",
      "maxLength": 60
    },
    "kicker": {
      "type": "string",
      "maxLength": 36,
      "description": "Uppercase tracked kicker, clay (edge on dark). Keep under ~28 characters."
    },
    "name": {
      "type": "string",
      "maxLength": 40
    },
    "era": {
      "type": "string",
      "maxLength": 40
    },
    "did_label": {
      "type": "string",
      "maxLength": 24
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 56
      },
      "description": "Check rows: clay circle with a paper tick."
    },
    "sources": {
      "type": "string",
      "maxLength": 120,
      "description": "Plain list of sources, e.g. biographies or archives. Required before publishing."
    },
    "counter": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "index",
        "total"
      ],
      "description": "Page counter; also positions the thread node."
    }
  },
  "required": [
    "image_label",
    "kicker",
    "name",
    "era",
    "did_label",
    "rows",
    "sources"
  ]
}
