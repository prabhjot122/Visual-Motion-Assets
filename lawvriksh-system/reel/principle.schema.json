{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/reel/principle.schema.json",
  "title": "Principle card",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper grain or solid warm ink"
    },
    "number": {
      "type": "string",
      "maxLength": 14
    },
    "title_html": {
      "type": "string",
      "maxLength": 110,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Statement. Emphasis with <b>…</b> (clay), at most two phrases. Only <b> and <br> are allowed; never <i>."
    },
    "body_html": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Muted supporting line. Optional <b> emphasis."
    },
    "motif": {
      "enum": [
        "reports",
        "files",
        "checked",
        "open-book",
        "courthouse",
        "calendar",
        "notes",
        "compare",
        "judgment",
        "register"
      ],
      "description": "Law object drawn from the library materials; pick the one that matches the idea of the page."
    },
    "scene_index": {
      "type": "integer",
      "minimum": 1
    },
    "scene_total": {
      "type": "integer",
      "minimum": 1
    },
    "caption_style": {
      "enum": [
        "ink-band",
        "paper-slip",
        "edge-word",
        "stack",
        "highlighter"
      ]
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "w": {
            "type": "string"
          },
          "s": {
            "type": "number"
          },
          "e": {
            "type": "number"
          }
        },
        "required": [
          "w",
          "s",
          "e"
        ]
      },
      "description": "Word timings in seconds from the voiceover; the current word is highlighted."
    }
  },
  "required": [
    "number",
    "title_html"
  ]
}
