{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/blog/thumbnails/case-explained.schema.json",
  "title": "Case explained",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper or solid warm ink."
    },
    "court": {
      "type": "string",
      "maxLength": 40
    },
    "date": {
      "type": "string",
      "maxLength": 24
    },
    "topic": {
      "type": "string",
      "maxLength": 80
    }
  },
  "required": [
    "court",
    "date",
    "topic"
  ]
}
