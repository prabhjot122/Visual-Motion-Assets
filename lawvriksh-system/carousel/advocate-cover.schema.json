{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/carousel/advocate-cover.schema.json",
  "title": "Advocate series — cover",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper grain or solid warm ink"
    },
    "kicker": {
      "type": "string",
      "maxLength": 36,
      "description": "Uppercase tracked kicker, clay (edge on dark). Keep under ~28 characters."
    },
    "image": {
      "type": "string",
      "description": "Relative path to a licensed image. Leave empty to show the labelled frame."
    },
    "image_alt": {
      "type": "string",
      "maxLength": 120
    },
    "image_label": {
      "type": "string",
      "maxLength": 60
    },
    "name": {
      "type": "string",
      "maxLength": 40
    },
    "era": {
      "type": "string",
      "maxLength": 40
    },
    "body_html": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Muted supporting line. Optional <b> emphasis."
    },
    "counter": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "index",
        "total"
      ],
      "description": "Page counter; also positions the thread node."
    }
  },
  "required": [
    "kicker",
    "image_label",
    "name",
    "era"
  ]
}
