{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/blog/graphics/document-callouts-07-numbered-pins.schema.json",
  "title": "Document callout 7 — numbered-pins",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper or solid warm ink."
    },
    "kicker": {
      "type": "string",
      "maxLength": 40,
      "description": "Uppercase tracked kicker (clay; edge on dark)."
    },
    "title_html": {
      "type": "string",
      "maxLength": 90,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Headline. Emphasis with <b>…</b> (clay), at most two phrases. Only <b> and <br> are allowed; never <i>."
    },
    "pinpoint": {
      "type": "string",
      "maxLength": 56,
      "description": "Pinpoint, e.g. “[Court], [date], para [n]”."
    },
    "callout": {
      "type": "string",
      "maxLength": 120
    },
    "pins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 40
      }
    }
  },
  "required": []
}
