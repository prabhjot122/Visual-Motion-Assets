{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/blog/thumbnails/checklist-teaser.schema.json",
  "title": "Checklist teaser",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper or solid warm ink."
    },
    "kicker": {
      "type": "string",
      "maxLength": 40,
      "description": "Uppercase tracked kicker (clay; edge on dark)."
    },
    "title_html": {
      "type": "string",
      "maxLength": 90,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Headline. Emphasis with <b>…</b> (clay), at most two phrases. Only <b> and <br> are allowed; never <i>."
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 36
      }
    },
    "teaser_more": {
      "type": "string",
      "maxLength": 36
    },
    "meta": {
      "type": "string",
      "maxLength": 36,
      "description": "Right side of the footer, e.g. “[n] min read”."
    }
  },
  "required": [
    "kicker",
    "title_html",
    "rows",
    "teaser_more"
  ]
}
