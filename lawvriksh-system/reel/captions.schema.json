{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caption track",
  "type": "object",
  "properties": {
    "caption_style": {
      "enum": [
        "ink-band",
        "paper-slip",
        "edge-word",
        "stack",
        "highlighter"
      ]
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "w": {
            "type": "string"
          },
          "s": {
            "type": "number"
          },
          "e": {
            "type": "number"
          }
        },
        "required": [
          "w",
          "s",
          "e"
        ]
      },
      "description": "Word timings in seconds from the voiceover; the current word is highlighted."
    }
  }
}
