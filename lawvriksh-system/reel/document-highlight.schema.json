{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/reel/document-highlight.schema.json",
  "title": "Document highlight",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper grain or solid warm ink"
    },
    "kicker": {
      "type": "string",
      "maxLength": 36,
      "description": "Uppercase tracked kicker, clay (edge on dark). Keep under ~28 characters."
    },
    "title_html": {
      "type": "string",
      "maxLength": 110,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Statement. Emphasis with <b>…</b> (clay), at most two phrases. Only <b> and <br> are allowed; never <i>."
    },
    "pinpoint": {
      "type": "string",
      "maxLength": 24,
      "description": "Pinpoint chip shown above the page, e.g. “Para [n]”."
    },
    "scene_index": {
      "type": "integer",
      "minimum": 1
    },
    "scene_total": {
      "type": "integer",
      "minimum": 1
    },
    "caption_style": {
      "enum": [
        "ink-band",
        "paper-slip",
        "edge-word",
        "stack",
        "highlighter"
      ]
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "w": {
            "type": "string"
          },
          "s": {
            "type": "number"
          },
          "e": {
            "type": "number"
          }
        },
        "required": [
          "w",
          "s",
          "e"
        ]
      },
      "description": "Word timings in seconds from the voiceover; the current word is highlighted."
    }
  },
  "required": [
    "kicker",
    "title_html",
    "pinpoint"
  ]
}
