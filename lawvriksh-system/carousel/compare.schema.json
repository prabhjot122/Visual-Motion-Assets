{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawvriksh-system/carousel/compare.schema.json",
  "title": "Comparison — this, not that",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "paper",
        "dark"
      ],
      "default": "paper",
      "description": "Ground: paper grain or solid warm ink"
    },
    "kicker": {
      "type": "string",
      "maxLength": 36,
      "description": "Uppercase tracked kicker, clay (edge on dark). Keep under ~28 characters."
    },
    "title_html": {
      "type": "string",
      "maxLength": 110,
      "pattern": "^(?!.*<(?!/?b>|br ?/?>)).*$",
      "description": "Statement. Emphasis with <b>…</b> (clay), at most two phrases. Only <b> and <br> are allowed; never <i>."
    },
    "not_label": {
      "type": "string",
      "maxLength": 22
    },
    "not_text": {
      "type": "string",
      "maxLength": 90
    },
    "this_label": {
      "type": "string",
      "maxLength": 22
    },
    "this_text": {
      "type": "string",
      "maxLength": 90
    },
    "counter": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "index",
        "total"
      ],
      "description": "Page counter; also positions the thread node."
    }
  },
  "required": [
    "kicker",
    "title_html",
    "not_label",
    "not_text",
    "this_label",
    "this_text"
  ]
}
